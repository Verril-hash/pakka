{
  "name": "pakka",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pakka — voice agents that keep Bengaluru rental listings honest",
  "scripts": {
    "start": "node --env-file=.env server/index.mjs",
    "db:reset": "node -e \"require('fs').rmSync('data/db.json',{force:true})\"",
    "tenant:call": "node --env-file=.env scripts/tenant-call.mjs",
    "agent:sync": "node --env-file=.env scripts/sync-agent.mjs",
    "extractions:sync": "node --env-file=.env scripts/sync-extractions.mjs",
    "call:test": "node --env-file=.env scripts/test-call.mjs",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "inbound:link": "node --env-file=.env scripts/link-inbound.mjs",
    "deploy": "gcloud run deploy pakka --source . --region asia-south1 --project pakka-552af --account verrilvaz404@gmail.com --quiet",
    "wa:verify": "node --env-file=.env scripts/whatsapp-verify.mjs",
    "wa:setup": "node --env-file=.env scripts/whatsapp-setup.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0"
  }
}
