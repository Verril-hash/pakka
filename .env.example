# Copy to .env and fill in. Never commit .env.

# Bolna (voice agents)
BOLNA_API_KEY=
PAKKA_CHECK_AGENT_ID=        # created by: npm run agent:sync -- check
PAKKA_LINE_AGENT_ID=         # created by: npm run agent:sync -- line
# Agent id(s) Pakka scripts must never modify (e.g. other apps on the same Bolna account)
AVARAN_AGENT_ID_DO_NOT_TOUCH=

# Server
PUBLIC_URL=                  # https URL Bolna uses to reach this server (tunnel or Cloud Run)
PAKKA_TOOL_TOKEN=            # random secret; Bolna sends it on mid-call function calls
PORT=8787

# Team console access: comma-separated +91 numbers
TEAM_PHONES=

# Sample listings' owner phones (seed data only)
OWNER_PHONE_1=
OWNER_PHONE_2=

# Firebase Admin (server verifies sign-ins). Path to the service-account JSON; never commit the file.
FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json

# Pakka phone number bought on Bolna (caller ID for both agents; inbound goes to Pakka Line)
PAKKA_FROM_NUMBER=
PAKKA_FROM_NUMBER_ID=

# Phone carrier for both agents: vobiz (+91 number) or twilio (US number)
PAKKA_CARRIER=vobiz
